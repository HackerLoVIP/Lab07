    {
      "name": "GET Comments By PostId",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response la mang comments\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "});",
              "pm.test(\"Tat ca comment deu co postId = 1\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.forEach(function(item) {",
              "        pm.expect(item.postId).to.eql(1);",
              "    });",
              "});",
              "pm.test(\"Comment co truong email va body\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData[0]).to.have.property(\"email\");",
              "    pm.expect(jsonData[0]).to.have.property(\"body\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
